{
  "name": "n-payment",
  "version": "0.27.0",
  "description": "Multi-protocol payment SDK for Web3 agents — iUSD on Initia (Cosmos-SDK) + USDC-anywhere → iUSD bridge corridor via Skip API / LayerZero / Wormhole NTT (v0.23), RLUSD multichain via Wormhole NTT (Ethereum + Base + Optimism + Ink + Unichain, v0.22), Stellar multi-stable (MGUSD + USDC + EURC, v0.21), x402, MPP, GOAT x402 + USDC Acquisition Router (v0.17), XRPL (RLUSD + auto XRP→RLUSD swap + XLS-65 vault treasury, v0.14), Flare FXRP direct-minting bridge on Coston2 (v0.15), Circle Nanopayments, AP2, Morph Network with HMAC facilitator + Reference Key, SpaceRouter residential-proxy bandwidth on Creditcoin (v0.11), Aave yield-bearing treasury with GHO + Flash Mint + Credit Delegation (v0.13), batch settlement, streaming payments with policy engine and OWS wallet security",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./spacerouter": {
      "types": "./dist/spacerouter/index.d.ts",
      "import": "./dist/spacerouter/index.mjs",
      "require": "./dist/spacerouter/index.js"
    },
    "./mcp": {
      "types": "./dist/agent/mcp-server.d.ts",
      "import": "./dist/agent/mcp-server.mjs",
      "require": "./dist/agent/mcp-server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },

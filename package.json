{
  "name": "n-payment",
  "version": "0.12.0",
  "description": "Multi-protocol payment SDK for Web3 agents — x402, MPP, GOAT x402, Stellar (x402 + MPP Charge + Session payment channels), XRPL, Circle Nanopayments, AP2, Morph Network with HMAC facilitator + Reference Key, SpaceRouter residential-proxy bandwidth on Creditcoin (v0.11), batch settlement, streaming payments with policy engine and OWS wallet security",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./spacerouter": {
      "types": "./dist/spacerouter/index.d.ts",
      "import": "./dist/spacerouter/index.mjs",
      "require": "./dist/spacerouter/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "x402",
    "mpp",
    "payment",
    "web3",
    "stablecoin",
    "USDC",
    "ai-agents",
    "micropayments",
    "bazaar",
    "service-discovery",
    "off-ramp",
    "base",
    "goat-network",
    "morph-network",
    "reference-key",
    "agentic-payments",
    "stellar",
    "soroban",
    "payment-channels",
    "freighter",
    "ows",
    "spacerouter",
    "spacecoin",
    "creditcoin",
    "residential-proxy",
    "agentic-bandwidth"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phamdat721101/n-payment.git"
  },
  "homepage": "https://github.com/phamdat721101/n-payment#readme",
  "author": "phamdat",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^15.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "express": "^5.2.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@open-wallet-standard/core": ">=0.1.0",
    "@solana/spl-token": ">=0.4.0",
    "@solana/web3.js": ">=1.90.0",
    "@spacenetwork/spacerouter": ">=1.5.0",
    "@stellar/freighter-api": ">=4.0.0",
    "@stellar/mpp": ">=0.1.0",
    "@stellar/stellar-sdk": ">=12.0.0",
    "@x402/core": ">=0.1.0",
    "@x402/evm": ">=0.1.0",
    "@x402/fetch": ">=0.1.0",
    "@x402/stellar": ">=0.1.0",
    "mppx": ">=0.1.0",
    "xrpl": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@open-wallet-standard/core": {
